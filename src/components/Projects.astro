---
import { getCollection } from 'astro:content';
import Todo from './Todo.astro';
import Screenshot from './Screenshot.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="container section" aria-labelledby="projects-heading">
  <h2 id="projects-heading">Projects</h2>
  <p><Todo>screenshots for Basketball Tracker and Flights Overhead once they're live</Todo></p>
  <div class="list">
    {
      projects.map(({ id, data, body }) => (
        <article class:list={['project', { 'has-thumb': data.screenshots }]}>
          {data.screenshots && (
            <div class="thumb">
              <Screenshot {...data.screenshots[0]} widths={[180, 360, 540]} sizes="180px" />
            </div>
          )}
          <h3>{data.title}</h3>
          <p class="problem">{data.problem}</p>
          <p>{data.summary}</p>
          <ul class="tags" aria-label="Built with">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <ul class="links">
            {body?.trim() && (
              <li>
                <a href={`/projects/${id}`}>
                  Case study<span class="visually-hidden">: {data.title}</span>
                </a>
              </li>
            )}
            <li>
              {data.liveStatus === 'live' ? (
                <a href={data.live}>
                  Live site<span class="visually-hidden"> for {data.title}</span>
                </a>
              ) : (
                <span class="soon">Coming soon</span>
              )}
            </li>
            {data.code && (
              <li>
                <a href={data.code}>
                  Code on GitHub<span class="visually-hidden"> for {data.title}</span>
                </a>
              </li>
            )}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .project {
    padding-top: var(--space-3);
    border-top: 2px solid var(--text);
  }

  /* Thumbnail sits beside the text on wide screens and above it on phones. */
  .has-thumb {
    display: grid;
    grid-template-columns: 1fr;
  }

  .thumb {
    width: 9rem;
    margin-bottom: var(--space-3);
  }

  @media (min-width: 48rem) {
    .has-thumb {
      grid-template-columns: 1fr 180px;
      column-gap: var(--space-5);
    }

    .has-thumb > :not(.thumb) {
      grid-column: 1;
    }

    .thumb {
      grid-column: 2;
      grid-row: 1 / span 6;
      width: 180px;
      margin-bottom: 0;
    }
  }

  .problem {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags {
    gap: var(--space-1) var(--space-2);
    margin-bottom: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .tags li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-2);
  }

  .links {
    gap: var(--space-3);
    font-weight: 500;
  }

  .soon {
    color: var(--muted);
  }
</style>
