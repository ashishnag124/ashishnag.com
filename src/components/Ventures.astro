---
import Screenshot from './Screenshot.astro';
import selectiveSips from '../assets/ventures/selective-sips.png';
import settld from '../assets/ventures/settld.png';
import ssLogo from '../assets/ventures/selectivesips-logo.svg';
import ssLogoReversed from '../assets/ventures/selectivesips-logo-reversed.svg';

const thumb = { frame: 'desktop' as const, widths: [480, 720, 1040], sizes: '(min-width: 48rem) 34rem, 100vw' };
---

<section id="ventures" class="container section" aria-labelledby="ventures-heading">
  <h2 id="ventures-heading">Ventures</h2>
  <div class="cards">
    <article class="card">
      <Screenshot
        src={selectiveSips}
        alt="Selective Sips homepage: “A cellar built around your palate”, wine cellar consulting in California, with WSET Level 3, 30+ regions sourced and 3 expert consultants."
        {...thumb}
      />
      <h3>
        <picture>
          <source srcset={ssLogoReversed.src} media="(prefers-color-scheme: dark)" />
          <img class="logo" src={ssLogo.src} alt="Selective Sips" width="210" height="32" />
        </picture>
      </h3>
      <p class="role">Founder & Lead Consultant</p>
      <p>
        Cellar strategy, sourcing, and collection management for private clients in California,
        delivered by a team of three WSET Level 3–certified consultants.
      </p>
      <p class="link"><a href="https://selectivesips.com">selectivesips.com</a></p>
    </article>

    <article class="card">
      <Screenshot
        src={settld}
        alt="Settld homepage: “Your team’s decisions, kept straight by AI”, above a sample decision log entry flagged as a conflict with an earlier decision."
        {...thumb}
      />
      <h3>Settld</h3>
      <p class="role">Founder</p>
      <p>
        Settld turns decisions scattered across meetings, Slack, email, and Teams into one
        searchable record, with an owner and deadline for each, and flags when a new decision
        contradicts an old one. Live with free, Team, and Business plans.
      </p>
      <p class="link"><a href="https://www.itssettld.com/">itssettld.com</a></p>
    </article>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-3);
    border-top: 2px solid var(--text);
  }

  .card > :global(.shot) {
    margin-bottom: var(--space-3);
  }

  .logo {
    display: block;
    width: auto;
    height: 2rem;
  }

  .card h3 {
    margin-bottom: var(--space-1);
  }

  .role {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .link {
    margin-top: auto;
    margin-bottom: 0;
  }
</style>
