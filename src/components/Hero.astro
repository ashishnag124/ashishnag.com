---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import { EMAIL, LINKEDIN } from '../site';
---

<section class="container hero" aria-labelledby="hero-heading">
  <div class="intro">
    <Image
      class="headshot"
      src={headshot}
      alt="Photo of Ashish Nag"
      width={200}
      height={200}
      format="webp"
      loading="eager"
    />
    <h1 id="hero-heading">Ashish Nag</h1>
  </div>
  <p class="lede">
    Product leader who builds. I turn messy problems into shipped systems — at work, in my own
    company, and in products I build end to end.
  </p>
  <p class="currently">
    <span class="label">Currently</span> Director of Product Management at Vida Health · San Francisco
  </p>
  <ul class="actions">
    <li><a class="button" href={LINKEDIN}>LinkedIn</a></li>
    <li><a class="button" href={`mailto:${EMAIL}`}>Email</a></li>
  </ul>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .intro {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .intro h1 {
    margin: 0;
  }

  .headshot {
    flex-shrink: 0;
    width: clamp(5.5rem, 4.5rem + 4vw, 7rem);
    height: auto;
    border-radius: 50%;
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .currently {
    color: var(--muted);
  }

  .label {
    margin-right: 0.4em;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .button {
    display: inline-block;
    padding: 0.55em 1.2em;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  a.button:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
</style>
