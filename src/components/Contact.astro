---
import Todo from './Todo.astro';
import { EMAIL, LINKEDIN, RESUME } from '../site';
---

<section id="contact" class="container section" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact</h2>
  <p>
    I'm interested in <Todo>senior product / program roles in X</Todo>, and in talking with founders
    building <Todo>Y</Todo>. The fastest way to reach me is {
      EMAIL ? <a href={`mailto:${EMAIL}`}>{EMAIL}</a> : <Todo>email</Todo>
    }.
  </p>
  <ul class="links">
    <li>{EMAIL ? <a href={`mailto:${EMAIL}`}>Email</a> : <>Email <Todo>public email address</Todo></>}</li>
    <li><a href={LINKEDIN}>LinkedIn</a></li>
    <li>
      {RESUME ? <a href={RESUME}>Résumé (PDF)</a> : <>Résumé PDF <Todo>add file to public/resume.pdf</Todo></>}
    </li>
  </ul>
</section>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
</style>
